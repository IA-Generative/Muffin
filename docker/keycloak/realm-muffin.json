{
  "realm": "muffin",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Full administrative access to Muffin" },
      { "name": "user", "description": "Standard Muffin user" }
    ],
    "client": {
      "muffin-backend": [
        { "name": "admin", "description": "Full administrative access to Muffin" },
        { "name": "user", "description": "Standard Muffin user" }
      ]
    }
  },
  "groups": [{ "name": "muffin-dev-team", "path": "/muffin-dev-team" }],
  "clients": [
    {
      "clientId": "muffin-backend",
      "name": "Muffin BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "secret": "dev-only-secret-not-for-prod",
      "redirectUris": ["http://localhost:8000/api/auth/callback"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8081"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173##http://localhost:8081"
      },
      "protocolMappers": [
        {
          "name": "client-roles-in-userinfo",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "muffin-backend",
            "claim.name": "resource_access.muffin-backend.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "michou",
      "email": "michou@example.com",
      "firstName": "Michou",
      "lastName": "Dev",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "muffin-dev", "temporary": false }],
      "realmRoles": ["admin", "user"],
      "clientRoles": {
        "muffin-backend": ["admin", "user"]
      }
    },
    {
      "username": "julie",
      "email": "julie@example.com",
      "firstName": "Julie",
      "lastName": "Test",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "muffin-dev", "temporary": false }],
      "realmRoles": ["user"],
      "clientRoles": {
        "muffin-backend": ["user"]
      },
      "groups": ["/muffin-dev-team"]
    }
  ]
}

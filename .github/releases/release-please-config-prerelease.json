{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "include-component-in-tag": false,
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "rc",
      "extra-files": [
        {
          "type": "json",
          "path": "frontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "backend/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "backend/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='muffin-backend')].version"
        },
        {
          "type": "toml",
          "path": "worker/agent_execution/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/agent_execution/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='muffin-worker-agent-execution')].version"
        },
        {
          "type": "toml",
          "path": "worker/document_edit/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/document_edit/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='muffin-worker-document-edit')].version"
        },
        {
          "type": "toml",
          "path": "worker/document_process/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/document_process/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='muffin-worker-document-process')].version"
        },
        {
          "type": "toml",
          "path": "worker/evaluation/pyproject.toml",
          "jsonpath": "project.version"
        },
        {
          "type": "toml",
          "path": "worker/evaluation/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='muffin-worker-evaluation')].version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "Performance Improvements",
          "hidden": false
        },
        {
          "type": "revert",
          "section": "Reverts",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Code Refactoring",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Dependencies",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Styles",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous Chores",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "Continuous Integration",
          "hidden": true
        }
      ]
    }
  }
}

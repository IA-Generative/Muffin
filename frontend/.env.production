# Production build defaults for the frontend.
#
# In preprod/prod, the ingress serves `/api/` → backend and `/` → frontend on
# the SAME host (same origin), so the frontend must call the backend with
# RELATIVE paths (`/api/...`), not an absolute URL. Setting VITE_API_BASE_URL
# to an empty string makes every `fetch(`${API_BASE_URL}/api/...`)` resolve to
# a same-origin relative request.
#
# Vite loads this file automatically during `pnpm build` (NODE_ENV=production),
# see https://vite.dev/guide/env-and-mode#env-files.
VITE_API_BASE_URL=
